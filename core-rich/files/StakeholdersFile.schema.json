{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencaptablecoalition.com/ocf-core/v0/files/StakeholdersFile.schema.json",
  "title": "OCF Core — StakeholdersFile",
  "description": "Generated. Core-admissible Stakeholder; values inlined into OCF grammar.",
  "type": "object",
  "properties": {
    "file_type": {
      "const": "OCF_STAKEHOLDERS_FILE"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "Stakeholder",
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "address_type": {
                  "type": "string",
                  "enum": [
                    "LEGAL",
                    "CONTACT",
                    "OTHER"
                  ]
                },
                "city": {
                  "type": "string"
                },
                "country": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$",
                  "minLength": 2,
                  "maxLength": 2
                },
                "country_subdivision": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{1,}$",
                  "minLength": 1,
                  "maxLength": 3
                },
                "postal_code": {
                  "type": "string"
                },
                "street_suite": {
                  "type": "string"
                }
              },
              "required": [
                "address_type",
                "country"
              ]
            },
            "description": "Addresses for the stakeholder"
          },
          "contact_info": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "emails": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "email_address": {
                      "type": "string"
                    },
                    "email_type": {
                      "type": "string",
                      "enum": [
                        "PERSONAL",
                        "BUSINESS",
                        "OTHER"
                      ]
                    }
                  },
                  "required": [
                    "email_type",
                    "email_address"
                  ]
                }
              },
              "phone_numbers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "phone_number": {
                      "type": "string",
                      "pattern": "^\\+\\d{1,3}\\s\\d{2,3}\\s\\d{2,3}\\s\\d{4}(\\s(ext.|extension)\\s\\d+)?$"
                    },
                    "phone_type": {
                      "type": "string",
                      "enum": [
                        "HOME",
                        "MOBILE",
                        "BUSINESS",
                        "OTHER"
                      ]
                    }
                  },
                  "required": [
                    "phone_type",
                    "phone_number"
                  ]
                }
              }
            },
            "anyOf": [
              {
                "required": [
                  "phone_numbers"
                ]
              },
              {
                "required": [
                  "emails"
                ]
              }
            ],
            "description": "The contact info for an individual stakeholder"
          },
          "current_relationship": {
            "type": "string",
            "enum": [
              "ADVISOR",
              "BOARD_MEMBER",
              "CONSULTANT",
              "EMPLOYEE",
              "EX_ADVISOR",
              "EX_CONSULTANT",
              "EX_EMPLOYEE",
              "EXECUTIVE",
              "FOUNDER",
              "INVESTOR",
              "NON_US_EMPLOYEE",
              "OFFICER",
              "OTHER"
            ],
            "description": "What is the current relationship of the stakeholder to the issuer?"
          },
          "current_relationships": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADVISOR",
                "BOARD_MEMBER",
                "CONSULTANT",
                "EMPLOYEE",
                "EX_ADVISOR",
                "EX_CONSULTANT",
                "EX_EMPLOYEE",
                "EXECUTIVE",
                "FOUNDER",
                "INVESTOR",
                "NON_US_EMPLOYEE",
                "OFFICER",
                "OTHER"
              ]
            },
            "description": "What is/are the current relationship(s) of the stakeholder to the issuer?"
          },
          "id": {
            "type": "string",
            "description": "Identifier for the object"
          },
          "issuer_assigned_id": {
            "type": "string",
            "description": "This might be any sort of id assigned to the stakeholder by the issuer, such as an internal company ID for an employee stakeholder"
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "legal_name": {
                "type": "string"
              }
            },
            "required": [
              "legal_name"
            ],
            "description": "Name for the stakeholder"
          },
          "object_type": {
            "const": "STAKEHOLDER"
          },
          "primary_contact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "emails": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "email_address": {
                      "type": "string"
                    },
                    "email_type": {
                      "type": "string",
                      "enum": [
                        "PERSONAL",
                        "BUSINESS",
                        "OTHER"
                      ]
                    }
                  },
                  "required": [
                    "email_type",
                    "email_address"
                  ]
                }
              },
              "name": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "legal_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "legal_name"
                ]
              },
              "phone_numbers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "phone_number": {
                      "type": "string",
                      "pattern": "^\\+\\d{1,3}\\s\\d{2,3}\\s\\d{2,3}\\s\\d{4}(\\s(ext.|extension)\\s\\d+)?$"
                    },
                    "phone_type": {
                      "type": "string",
                      "enum": [
                        "HOME",
                        "MOBILE",
                        "BUSINESS",
                        "OTHER"
                      ]
                    }
                  },
                  "required": [
                    "phone_type",
                    "phone_number"
                  ]
                }
              }
            },
            "anyOf": [
              {
                "required": [
                  "name",
                  "phone_numbers"
                ]
              },
              {
                "required": [
                  "name",
                  "emails"
                ]
              }
            ],
            "description": "The primary contact info for an institutional stakeholder"
          },
          "stakeholder_type": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "INSTITUTION"
            ],
            "description": "Distinguish individuals from institutions"
          }
        },
        "required": [
          "object_type",
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "file_type",
    "items"
  ],
  "additionalProperties": false
}
