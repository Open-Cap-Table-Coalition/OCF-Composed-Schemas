{
  "name": "ocf-composed-schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "mapping:skeleton": "node --loader ts-node/esm --no-warnings ./scripts/generate-mapping-skeletons.ts",
    "mapping:validate": "node --loader ts-node/esm --no-warnings ./scripts/validate-mappings.ts",
    "mapping:inverse": "node --loader ts-node/esm --no-warnings ./scripts/validate-mappings.ts --inverse",
    "mapping:artifacts": "node --loader ts-node/esm --no-warnings ./scripts/generate-mapping-inverse-artifacts.ts",
    "mapping:artifacts:check": "node --loader ts-node/esm --no-warnings ./scripts/generate-mapping-inverse-artifacts.ts --check",
    "mapping:question-links": "node --loader ts-node/esm --no-warnings ./scripts/update-mapping-question-links.ts",
    "mapping:coverage": "node --loader ts-node/esm --no-warnings ./scripts/derive-mapping-coverage.ts",
    "mapping:coverage:check": "node --loader ts-node/esm --no-warnings ./scripts/derive-mapping-coverage.ts --check",
    "mapping:references": "node --loader ts-node/esm --no-warnings ./scripts/derive-reference-sites.ts",
    "provenance:check": "node --loader ts-node/esm --no-warnings ./scripts/check-provenance.ts",
    "carta:refresh:check": "node --loader ts-node/esm --no-warnings ./scripts/check-carta-schema-refresh.ts",
    "core:report": "node --loader ts-node/esm --no-warnings ./scripts/derive-core-report.ts",
    "core:build": "node --loader ts-node/esm --no-warnings ./scripts/derive-core-build.ts",
    "core:check": "node --loader ts-node/esm --no-warnings ./scripts/derive-core-check.ts",
    "core:validate-sample": "node --loader ts-node/esm --no-warnings ./scripts/validate-core-sample.ts",
    "core:lossy": "node --loader ts-node/esm --no-warnings ./scripts/derive-core-lossy-inventory.ts",
    "core:unmapped": "node --loader ts-node/esm --no-warnings ./scripts/derive-core-unmapped-inventory.ts",
    "test": "node --experimental-vm-modules --experimental-json-modules --no-warnings node_modules/.bin/jest",
    "lint": "prettier --check \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "prettier --write \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsonpointer": "^5.0.1",
    "minimatch": "^10.0.1",
    "yaml": "^2.8.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.32",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "prettier": "2.5.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
