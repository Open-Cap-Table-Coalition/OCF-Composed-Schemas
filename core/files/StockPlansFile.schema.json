{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencaptablecoalition.com/ocf-core/v0/files/StockPlansFile.schema.json",
  "title": "OCF Core — StockPlansFile",
  "description": "Generated. Core-admissible StockPlan; values inlined into OCF grammar.",
  "type": "object",
  "properties": {
    "file_type": {
      "const": "OCF_STOCK_PLANS_FILE"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "StockPlan",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier for the object"
          },
          "object_type": {
            "const": "STOCK_PLAN"
          },
          "plan_name": {
            "type": "string",
            "description": "Name for the stock plan"
          }
        },
        "required": [
          "object_type",
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "file_type",
    "items"
  ],
  "additionalProperties": false
}
