          {
            "type": "object",
            "title": "ConvertibleCancellation",
            "properties": {
              "amount": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "amount": {
                    "type": "string",
                    "pattern": "^[+-]?[0-9]+(\\.[0-9]{1,10})?$"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$",
                    "minLength": 3,
                    "maxLength": 3
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ],
                "description": "Amount of monetary value cancelled"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Date on which the transaction occurred"
              },
              "id": {
                "type": "string",
                "description": "Identifier for the object"
              },
              "object_type": {
                "const": "TX_CONVERTIBLE_CANCELLATION"
              },
              "security_id": {
                "type": "string",
                "description": "Identifier for the security (stock, plan security, warrant, or convertible) by which it can be referenced by other transaction objects. N…"
              }
            },
            "required": [
              "object_type",
              "id"
            ],
            "additionalProperties": false
          },
