{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencaptablecoalition.com/ocf-core/v0/OCFCoreManifestFile.schema.json",
  "title": "OCF Core Manifest File",
  "description": "GENERATED by scripts/derive-core-build — do not hand-edit. A Core cap-table package: issuer + references to the Core object/transaction files. Mirrors OCFManifestFile (reuses OCF file_type consts) so a Core package is shape-valid OCF.",
  "type": "object",
  "properties": {
    "file_type": {
      "const": "OCF_MANIFEST_FILE"
    },
    "ocf_version": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issuer": {
      "type": "object",
      "title": "Issuer",
      "properties": {
        "dba": {
          "type": "string",
          "description": "Doing Business As name"
        },
        "id": {
          "type": "string",
          "description": "Identifier for the object"
        },
        "legal_name": {
          "type": "string",
          "description": "Legal name of the issuer"
        },
        "object_type": {
          "const": "ISSUER"
        }
      },
      "required": [
        "object_type",
        "id"
      ],
      "additionalProperties": false
    },
    "stakeholders_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filepath": {
            "type": "string"
          },
          "md5": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{32}$"
          }
        },
        "required": [
          "filepath",
          "md5"
        ]
      }
    },
    "stock_classes_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filepath": {
            "type": "string"
          },
          "md5": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{32}$"
          }
        },
        "required": [
          "filepath",
          "md5"
        ]
      }
    },
    "stock_plans_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filepath": {
            "type": "string"
          },
          "md5": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{32}$"
          }
        },
        "required": [
          "filepath",
          "md5"
        ]
      }
    },
    "transactions_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filepath": {
            "type": "string"
          },
          "md5": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{32}$"
          }
        },
        "required": [
          "filepath",
          "md5"
        ]
      }
    }
  },
  "required": [
    "file_type",
    "stakeholders_files",
    "stock_classes_files",
    "stock_plans_files",
    "transactions_files"
  ],
  "additionalProperties": false
}
